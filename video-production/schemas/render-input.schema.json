{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render-input.schema.json",
  "title": "What-if Video Provider-independent Render Input",
  "type": "object",
  "required": ["schema_version", "run_id", "content_frame", "timeline", "subtitles"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "content_frame": {
      "type": "object",
      "required": ["width", "height", "aspect_ratio"],
      "properties": {
        "width": {"const": 1280},
        "height": {"const": 720},
        "aspect_ratio": {"const": "16:9"}
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "start_ms", "duration_ms", "end_ms", "visual_assets", "audio_asset_id"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "duration_ms": {"type": "integer", "minimum": 1},
          "end_ms": {"type": "integer", "minimum": 1},
          "audio_asset_id": {"type": "string", "minLength": 1},
          "visual_assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["asset_id", "render_treatment", "start_ms", "duration_ms", "end_ms"],
              "properties": {
                "asset_id": {"type": "string", "minLength": 1},
                "render_treatment": {"enum": ["direct_video", "image_motion", "static_image"]},
                "start_ms": {"type": "integer", "minimum": 0},
                "duration_ms": {"type": "integer", "minimum": 1},
                "end_ms": {"type": "integer", "minimum": 1},
                "motion_intent": {"type": "string"},
                "fit": {
                  "type": "object",
                  "required": ["mode", "target_width", "target_height", "preserve_aspect_ratio", "stretch_allowed"],
                  "properties": {
                    "mode": {"enum": ["cover_crop", "none"]},
                    "target_width": {"const": 1280},
                    "target_height": {"const": 720},
                    "preserve_aspect_ratio": {"const": true},
                    "stretch_allowed": {"const": false}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "text", "start_ms", "end_ms", "primary_color"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "primary_color": {"const": "white"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
