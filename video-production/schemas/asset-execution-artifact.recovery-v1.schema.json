{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatif-video/video-production/schemas/asset-execution-artifact.recovery-v1.schema.json",
  "title": "WhatIf Video Asset Execution Artifact Recovery V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "asset_id",
    "status",
    "generation_route",
    "asset_kind",
    "role",
    "in_content_timeline",
    "prompt_sha256",
    "recovery_executor_reconstructed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUCCESS", "HOST_ACTION_REQUIRED", "BLOCK"]},
    "generation_route": {"enum": ["gpt-image-2", "happyhorse"]},
    "execution_route": {"enum": ["builtin_image_generation", "happyhorse"]},
    "asset_kind": {"enum": ["image", "video"]},
    "role": {"enum": ["content_visual", "execution_reference", "cover"]},
    "in_content_timeline": {"type": "boolean"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_size_bytes": {"type": "integer", "minimum": 1},
    "width": {"type": ["integer", "null"], "minimum": 1},
    "height": {"type": ["integer", "null"], "minimum": 1},
    "duration_ms": {"type": ["integer", "null"], "minimum": 1},
    "model_identity": {"type": "string", "minLength": 1},
    "provider_metadata": {"type": "object"},
    "host_action_request": {"type": "object"},
    "block_code": {"type": "string", "minLength": 1},
    "recovery_executor_reconstructed": {"const": true},
    "historical_executor_byte_identical": {"const": false}
  }
}
