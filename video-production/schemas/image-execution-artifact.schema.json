{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatif-video/video-production/schemas/image-execution-artifact.schema.json",
  "title": "Volcengine General 3.0 image execution artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "task_id", "asset_id", "status",
    "generation_route", "execution_route", "asset_kind", "role",
    "in_content_timeline", "prompt_sha256", "prompt_passthrough",
    "provider", "provider_model", "local_path", "sha256",
    "file_size_bytes", "width", "height", "max_concurrency_observed",
    "control_returned_to_caller", "ambiguous_task_submission",
    "recovery_executor_reconstructed", "historical_executor_byte_identical"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "status": {"const": "SUCCESS"},
    "generation_route": {"const": "gpt-image-2"},
    "execution_route": {"const": "volcengine_general3_t2i_api"},
    "asset_kind": {"const": "image"},
    "role": {"type": "string", "minLength": 1},
    "in_content_timeline": {"type": "boolean"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_passthrough": {"const": true},
    "provider": {"const": "volcengine"},
    "provider_model": {"const": "通用3.0-文生图"},
    "provider_task_id": {"type": ["string", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "provider_response_redacted": {"type": "object"},
    "local_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_size_bytes": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "max_concurrency_observed": {"const": 1},
    "control_returned_to_caller": {"const": true},
    "ambiguous_task_submission": {"const": false},
    "recovery_executor_reconstructed": {"const": true},
    "historical_executor_byte_identical": {"const": false}
  }
}
