{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatif-video/video-production/schemas/asset-dispatch.recovery-v1.schema.json",
  "title": "WhatIf Video Asset Dispatch Recovery V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "recovery_schema_reconstructed", "creative_replanning", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "recovery_schema_reconstructed": {"const": true},
    "creative_replanning": {"const": false},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "run_id", "asset_id", "role", "generation_route", "expected_asset_kind", "prompt", "in_content_timeline"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["content_visual", "execution_reference", "cover"]},
          "generation_route": {"enum": ["gpt-image-2", "happyhorse"]},
          "expected_asset_kind": {"enum": ["image", "video"]},
          "generation_mode": {"enum": ["T2V", "I2V", "R2V"]},
          "prompt": {"type": "string", "minLength": 1},
          "duration_ms": {"type": "integer", "minimum": 1},
          "segment_id": {"type": "string", "minLength": 1},
          "render_treatment": {"enum": ["static_image", "image_motion", "direct_video"]},
          "continuity": {"type": "object"},
          "motion_intent": {"type": "string"},
          "motion_parameters": {"type": "object"},
          "in_content_timeline": {"type": "boolean"}
        }
      }
    }
  }
}
